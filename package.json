{
  "name": "birds-client",
  "version": "1.0.0",
  "description": "Birds Client — a modern Minecraft mod manager and launcher shell",
  "main": "main.js",
  "scripts": {"start": "electron .", "dist": "electron-builder --win nsis"},
  "devDependencies": {"electron": "^33.2.1", "electron-builder": "^25.1.8"},
  "build": {"appId": "gg.birds.client", "productName": "Birds Client", "directories": {"output": "dist"}, "files": ["main.js", "preload.js", "src/**/*", "package.json"], "win": {"target": "nsis", "icon": "src/icon.png"}, "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}}
}